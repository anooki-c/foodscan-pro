# ============================================================
# 食品配料分析 · 服务端环境配置
# 复制为 .env.local 并按需填写。未配置的第三方服务自动回退 mock。
# ============================================================

# ---- 食品数据库（OFF） ----
# 关闭后首页隐藏条码入口（PRD §5.2）
OFF_ENABLED=true
# OFF API 地址（默认官方公开 API，无需 key）
OFF_API_URL=https://world.openfoodfacts.org

# ---- 第三方 OCR（PRD §7.4） ----
# 关闭时 OCR 回退到本地拆分模拟
OCR_ENABLED=false
OCR_PROVIDER=provider-a
OCR_API_URL=https://your-ocr-provider.example.com/v1/recognize
OCR_API_KEY=
OCR_TIMEOUT_MS=10000
OCR_CONFIDENCE_THRESHOLD=80

# ---- AI 配料解读（PRD §14） ----
# 关闭时结果页 AI 区块回退 mock 文案
AI_ENABLED=false
AI_PROVIDER=openai-compatible
AI_API_URL=https://api.example.com/v1/chat/completions
AI_API_KEY=
AI_TIMEOUT_MS=15000
