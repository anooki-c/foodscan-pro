# ============================================================
# 食品配料分析 · 服务端环境配置
#
# ⚠️ 注意：OCR 与 AI 配置已迁移到后台管理页（/admin/ocr、/admin/ai），
#    持久化在服务器 data/config.json，修改后立即生效，无需重启。
#    以下 OCR_* / AI_* 环境变量仅在【首次启动无配置文件】时作为默认值。
#
# 复制为 .env.local 并按需填写（可选，缺省即用内置默认）。
# ============================================================

# ---- 食品数据库（OFF） ----
# 关闭后首页隐藏条码入口（PRD §5.2）
OFF_ENABLED=true
# OFF API 地址（默认官方公开 API，无需 key）
OFF_API_URL=https://world.openfoodfacts.org

# ---- 第三方 OCR（可选默认值，后台可改） ----
OCR_ENABLED=false
OCR_PROVIDER=provider-a
OCR_API_URL=https://your-ocr-provider.example.com/v1/recognize
OCR_API_KEY=
OCR_TIMEOUT_MS=10000
OCR_CONFIDENCE_THRESHOLD=80

# ---- AI 配料解读（可选默认值，后台可改） ----
AI_ENABLED=false
AI_PROVIDER=openai-compatible
AI_API_URL=https://api.example.com/v1/chat/completions
AI_API_KEY=
AI_TIMEOUT_MS=15000
